# =============================================================================
# yinstall — 仅同步源码与少量根目录文档；本地日志、docs、Agent 规范不入库
# =============================================================================

# Build output
build/

# collect / stressos / install-db 归档
output/

# yinstall 日志（--log-dir 或仓库内 logs/）
logs/

# docs/ 整目录不同步（含 installer.md、plans/、templates/、architecture/ 等全部子路径）
docs/

# Claude / Cursor 开发规范（本地双副本，见 CLAUDE.md 与 .cursor/rules/*.mdc）
CLAUDE.md
.cursor/
*.mdc

# 临时单测（规范：仅 tmp/*_test.go，测完删除）
tmp/*
!tmp/.gitkeep

# 控制端 scratch
*.log
output_*.txt
sql_*.txt
*.trc

# OS / macOS（任意目录下的 Finder 元数据）
.DS_Store
**/.DS_Store
._*
**/_*

# Local env / credentials
.env
.env.*
*.env

.vscode/
.idea/

# Claude Code 本地工作区
.claude/

# Agent skills（本地维护，不同步）
skills/

# 本地安装命令草稿
*_install_cmd.txt
ymp_install_cmd.txt

# Markdown：默认忽略，白名单保留根目录核心文档（installer.md 已移至 docs/，随 docs/ 排除）
*.md
!README.md
!requirements.md
!HUAWEI_MULTIPATH_SUPPORT.md
!SSH_AUTH_IMPROVEMENT.md
