[client]
port={{.MYSQL_PORT}}
{{if .IsUnix}}socket={{.MYSQL_OTHER}}/mysql.sock
{{end}}default-character-set=utf8

[mysql]
no-auto-rehash
default-character-set=utf8

[mysqld]
{{if .IsLinux}}user=mysql
{{end}}port={{.MYSQL_PORT}}
mysqlx_port={{.MYSQLX_PORT}}
character-set-client-handshake=FALSE
character-set-server=utf8
collation-server=utf8mb4_unicode_ci
{{if .IsUnix}}socket={{.MYSQL_OTHER}}/mysql.sock
mysqlx_socket={{.MYSQL_OTHER}}/mysqlx.sock
{{end}}basedir={{.MYSQL_HOME}}
datadir={{.MYSQL_DATA}}
tmpdir={{.MYSQL_OTHER}}
explicit_defaults_for_timestamp=true
{{if .IsLinux}}lower_case_table_names=1
external-locking=FALSE
{{end}}back_log=103
max_connections=3000
max_connect_errors=100000
table_open_cache=512
max_allowed_packet=32M
sort_buffer_size=2M
join_buffer_size=2M
thread_cache_size=51
query_cache_size=32M
transaction_isolation=REPEATABLE-READ
tmp_table_size=96M
max_heap_table_size=96M
long_query_time=1
slow_query_log=1
slow_query_log_file={{.MYSQL_OTHER}}/slow.log
binlog_cache_size=4M
max_binlog_cache_size=8M
max_binlog_size=1024M
binlog_format=MIXED
expire_logs_days=7
server-id={{.SERVER_ID}}
log-bin={{.MYSQL_OTHER}}/mysql-bin
log-error={{.MYSQL_OTHER}}/error.log
{{if .IsUnix}}pid-file={{.MYSQL_OTHER}}/mysqld.pid
{{end}}key_buffer_size=16M
read_buffer_size=1M
read_rnd_buffer_size=16M
bulk_insert_buffer_size=1M
innodb_buffer_pool_size={{.INNODB_BUFFER_POOL_SIZE}}
innodb_data_file_path=ibdata1:10M:autoextend
innodb_thread_concurrency=16
innodb_flush_log_at_trx_commit=1
innodb_log_buffer_size=16M
innodb_log_file_size=1024M
innodb_log_files_in_group=4
innodb_max_dirty_pages_pct=75
innodb_buffer_pool_dump_pct=75
innodb_lock_wait_timeout=50
innodb_file_per_table=on
plugin-load={{.VALIDATE_PASSWORD_PLUGIN}}

[mysqldump]
quick
max_allowed_packet=32M

[myisamchk]
key_buffer=16M
sort_buffer_size=16M
read_buffer=8M
write_buffer=8M

{{if .IsUnix}}[mysqld_safe]
open-files-limit=8192
{{end}}
