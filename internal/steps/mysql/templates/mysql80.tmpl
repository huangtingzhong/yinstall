[client]
port={{.MYSQL_PORT}}
{{if .IsUnix}}socket={{.MYSQL_OTHER}}/mysql.sock
{{end}}default-character-set=utf8mb4

[mysql]
no-auto-rehash
default-character-set=utf8mb4
{{if .IsWindows}}prompt="\u@\h:\p \R:\m:\s [\d] > "
{{else}}prompt='\u@\h:\p \R:\m:\s [\d] > '
{{end}}
{{if .IsUnix}}[mysqld_safe]
open-files-limit=8192
log-error={{.MYSQL_OTHER}}/error.log
pid-file={{.MYSQL_OTHER}}/mysqld.pid

{{end}}[mysqldump]
quick
max_allowed_packet=32M

[myisamchk]
key_buffer=16M
sort_buffer_size=16M
read_buffer=8M
write_buffer=8M

[mysqld]
{{if .IsLinux}}user=mysql
{{end}}port={{.MYSQL_PORT}}
mysqlx_port={{.MYSQLX_PORT}}
character-set-server=utf8mb4
{{if .IsUnix}}socket={{.MYSQL_OTHER}}/mysql.sock
mysqlx_socket={{.MYSQL_OTHER}}/mysqlx.sock
{{end}}basedir={{.MYSQL_HOME}}
datadir={{.MYSQL_DATA}}
tmpdir={{.MYSQL_OTHER}}
disabled_storage_engines=ARCHIVE,BLACKHOLE,EXAMPLE,FEDERATED,MEMORY,MERGE,NDB,MyISAM
event_scheduler=0
explicit_defaults_for_timestamp=true
back_log=103
table_open_cache=8192
max_allowed_packet=32M
sort_buffer_size=16M
join_buffer_size=2M
thread_cache_size=200
transaction_isolation=READ-COMMITTED
tmp_table_size=96M
max_heap_table_size=96M
max_connections=3000
max_connect_errors=100000
long_query_time=10
slow_query_log=1
slow_query_log_file={{.MYSQL_OTHER}}/slow.log
binlog_cache_size=4M
max_binlog_cache_size=8M
max_binlog_size=1024M
binlog_format=ROW
log-bin={{.MYSQL_OTHER}}/mysql-bin
binlog_expire_logs_seconds=10800
server-id={{.SERVER_ID}}
enforce_gtid_consistency={{.ENFORCE_GTID_CONSISTENCY}}
gtid_mode={{.GTID_MODE}}
key_buffer_size=16M
read_buffer_size=1M
read_rnd_buffer_size=16M
bulk_insert_buffer_size=1M
sql_require_primary_key=1
log-error={{.MYSQL_OTHER}}/error.log
{{if .IsUnix}}pid-file={{.MYSQL_OTHER}}/mysqld.pid
{{end}}log_error_verbosity=3
log_timestamps=SYSTEM
default-time-zone=SYSTEM
wait_timeout=28800
interactive_timeout=28800
connect_timeout=20
slave-net-timeout=30
innodb_buffer_pool_size={{.INNODB_BUFFER_POOL_SIZE}}
innodb_buffer_pool_instances=8
innodb_data_file_path=ibdata1:10M:autoextend
innodb_thread_concurrency=16
innodb_flush_log_at_trx_commit=1
innodb_log_buffer_size=64M
innodb_max_dirty_pages_pct=80
{{.INNODB_REDO_OR_LOG_LINES}}
innodb_buffer_pool_dump_pct=75
innodb_lock_wait_timeout=30
innodb_file_per_table=1
innodb_print_all_deadlocks=1
{{if .IsLinux}}innodb_flush_method=O_DIRECT
{{end}}innodb_read_io_threads=16
innodb_write_io_threads=8
innodb_flush_neighbors=0
innodb_doublewrite_pages=128
innodb_parallel_read_threads=8
innodb_ddl_threads=8
innodb_ddl_buffer_size=1G
{{if not .IsWindows}}performance_schema=on
performance_schema_consumer_global_instrumentation=on
performance_schema_consumer_thread_instrumentation=on
performance_schema_consumer_events_stages_current=on
performance_schema_consumer_events_stages_history=on
performance_schema_consumer_events_stages_history_long=off
performance_schema_consumer_statements_digest=on
performance_schema_consumer_events_statements_current=on
performance_schema_consumer_events_statements_history=on
performance_schema_consumer_events_statements_history_long=off
performance_schema_consumer_events_waits_current=on
performance_schema_consumer_events_waits_history=on
performance_schema_consumer_events_waits_history_long=off
performance-schema-instrument='memory/%=COUNTED'
{{end}}
